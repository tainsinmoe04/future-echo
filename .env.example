# Copy to .env.local on this machine. Never put real secrets in chat or Git.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Choose a Gemini model supporting structured output and confirm pricing/access.
GEMINI_MODEL=
# Keep disabled until migration, privacy review and live safety tests pass.
FUTURE_ECHO_AI_ENABLED=false
# Private local trial only. Never enables /api/local-ai in production.
FUTURE_ECHO_LOCAL_AI=false
# WSL app + Windows Ollama only; fixed Windows localhost bridge, no network exposure.
FUTURE_ECHO_OLLAMA_WINDOWS_BRIDGE=false
# Private OpenRouter trial; fixed free model, no paid/provider fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
FUTURE_ECHO_OPENROUTER_TRIAL=false
